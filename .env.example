# ---- Database ----
DATABASE_URL=postgresql+psycopg://valuebet:valuebet@localhost:5432/valuebet
REDIS_URL=redis://localhost:6379/0

# ---- Betfair Exchange API ----
# https://developer.betfair.com/  (app key + session login)
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# Path to your client certificate (.crt) and key (.pem) for non-interactive login
BETFAIR_CERT_PATH=
BETFAIR_KEY_PATH=

# ---- Pinnacle API ----
# https://pinnacleapi.github.io/  (HTTP basic auth)
PINNACLE_USERNAME=
PINNACLE_PASSWORD=

# ---- Value engine tuning ----
# Minimum edge above the de-vigged fair probability before a signal fires (0.049 = 4.9%)
EDGE_THRESHOLD=0.049
# Require Pinnacle to agree (its fair prob within this tolerance of Betfair's) before a signal is valid
CONFIRMATION_TOLERANCE=0.03
# If true, never fire a signal without a matching Pinnacle price (no betting on Betfair alone)
REQUIRE_CONFIRMATION=true
# Only consider favorites: selection fair probability must be >= this
FAVORITE_MIN_PROB=0.55
# Kelly fraction (0.25 = quarter-Kelly). Keep small for the pilot.
KELLY_FRACTION=0.25
# Hard cap on stake per bet, in account currency
MAX_STAKE=10.0
# Bankroll used for Kelly sizing
BANKROLL=500.0

# ---- Polling cadence (seconds) ----
POLL_INTERVAL_LIVE=120
POLL_INTERVAL_PREMATCH=900

# ---- Stoiximan placement (SINGLE account) ----
STOIXIMAN_USERNAME=
STOIXIMAN_PASSWORD=
# Safety: when true, the worker computes & logs the bet slip but does NOT click "place".
# NOTHING is staked at the bookmaker while this is true — bets appear in the
# dashboard as "paper" and are excluded from P&L and exposure. Set false to bet for real.
PLACEMENT_DRY_RUN=true
# Require manual confirmation in the dashboard before any real bet is placed.
PLACEMENT_REQUIRE_APPROVAL=true
# Optional: Cyprus Proxy for Stoiximan (e.g. http://host:port or socks5://host:port)
STOIXIMAN_PROXY=
STOIXIMAN_PROXY_USERNAME=
STOIXIMAN_PROXY_PASSWORD=

# The Odds API bookmaker key the target prices are read from, and the book we
# actually place on. These must be the SAME book: quoting Betano while placing on
# Stoiximan means the detected price does not exist on the site we bet into, so
# placement fails price protection or clicks the wrong selection.
ODDS_API_TARGET_BOOKMAKER=betano_uk
PLACEMENT_BOOKMAKER=stoiximan

# ---- Safety switches ----
# When true, a scan finding no value falls back to mock sources, persisting FAKE
# signals ("Team A", "Real Madrid" at invented odds) that exist at no bookmaker
# and can never be placed. Demo only — keep false in any real deployment.
ALLOW_DEMO_FALLBACK=false
# When true, an unreachable DATABASE_URL is a hard error rather than silently
# writing to a local ./valuebet.db that nothing else reads.
STRICT_DATABASE=true

# ---- App ----
# INFO gives one funnel line per scan plus every money action (approve, place,
# bet_recorded, settle). DEBUG adds the per-market and per-selection reasons:
# market_unmatched (feed name mismatches), selection_unmatched, health_rejected,
# stale_odds_rejected, market_no_signals. Use DEBUG when a scan finds nothing or
# a placement fails and you need to know which stage dropped it.
LOG_LEVEL=INFO
ENV=dev
